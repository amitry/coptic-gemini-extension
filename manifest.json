{
  "manifest_version": 3,
  "name": "Coptic Hospital - Gemini Assistant",
  "version": "7.6",
  "description": "Clinical Decision Support Assistant & EHR Diagnostic Tool for Coptic Hospital",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "identity"
  ],
  "oauth2": {
    "client_id": "1000142398902-25gvf426hq028kc9dblb66g0mjqcle7p.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/userinfo.email",
      "https://www.googleapis.com/auth/userinfo.profile",
      "https://www.googleapis.com/auth/generative-language"
    ]
  },
  "host_permissions": [
    "*://*.unumed.net/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Coptic Assistant Diagnostics",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.unumed.net/*",
        "file:///*"
      ],
      "js": ["interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.unumed.net/*",
        "file:///*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "world": "ISOLATED",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["interceptor.js"],
      "matches": ["*://*.unumed.net/*", "file:///*"]
    }
  ]
}