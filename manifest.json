{
  "manifest_version": 3,
  "name": "Coptic Hospital - Gemini Assistant",
  "version": "1.3",
  "description": "Clinical Decision Support Assistant & EHR Diagnostic Tool for Coptic Hospital",
  "permissions": [
    "storage",
    "activeTab",
    "identity"
  ],
  "host_permissions": [
    "*://*.unumed.net/*",
    "https://generativelanguage.googleapis.com/*",
    "https://www.googleapis.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Coptic Assistant Diagnostics"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.unumed.net/*",
        "file:///*"
      ],
      "js": ["interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.unumed.net/*",
        "file:///*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "world": "ISOLATED",
      "all_frames": true
    }
  ]
}